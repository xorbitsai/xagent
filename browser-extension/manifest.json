{
  "manifest_version": 3,
  "name": "Xagent Browser Relay",
  "description": "Lets Xagent control only the Chrome tab you explicitly approve.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "debugger", "storage"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Xagent Browser Relay",
    "default_popup": "popup.html"
  }
}
