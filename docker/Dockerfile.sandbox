# syntax=docker/dockerfile:1.6
ARG UV_VERSION=0.11.10

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

############################
# Locked sandbox requirements
############################
FROM python:3.11-slim AS sandbox-requirements

ENV UV_PYTHON_DOWNLOADS=0

COPY --from=uv /uv /uvx /usr/local/bin/
WORKDIR /build
COPY pyproject.toml uv.lock ./

# Export only the dedicated sandbox dependency group. The lock metadata stays
# in this build stage instead of becoming part of the runtime image.
RUN uv export --quiet --locked --only-group sandbox --no-emit-project \
    --output-file /sandbox-requirements.txt

############################
# Sandbox runtime
############################
FROM node:22-slim AS sandbox

LABEL maintainer="xagent"
LABEL description="Full sandbox image with all tools"

COPY --from=uv /uv /uvx /usr/local/bin/

# Fixed, world-writable npm/npx cache location, set before anything in
# this stage might invoke npx. npm's default cache path is keyed to
# $HOME, which varies by which user actually runs a command -- root
# during this build, root at container runtime too (Docker-backed
# sandboxes: see the npx warm-up comment below), but not guaranteed to
# stay that way forever. A cache warmed under one user's $HOME and read
# from another's would silently stay cold; a single fixed path removes
# that failure mode regardless of which user npx runs as, now or later.
ENV NPM_CONFIG_CACHE=/opt/npm-cache
RUN mkdir -p "$NPM_CONFIG_CACHE" && chmod 1777 "$NPM_CONFIG_CACHE"

######################## python 3.11 install (apt)

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        netbase \
        tzdata \
        openssh-client \
        python3.11 \
        python3-pip \
        python3-venv \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/bin/pip3 /usr/local/bin/pip \
    && rm -rf /var/lib/apt/lists/* \
    && python --version && pip --version

######################## browser install (apt): Chrome on amd64, Chromium on arm64
#
# Browser for the built-in "chrome" MCP connector (chrome-devtools-mcp),
# mirroring Dockerfile.backend's INSTALL_CHROME block: that image only
# covers the non-sandboxed path (SANDBOX_ENABLED=false), where the connector
# runs directly on the backend host. Whenever a sandbox is configured,
# should_sandbox_mcp_connection() routes every npx/uvx-launched MCP
# connector -- chrome-devtools-mcp included -- into *this* image instead,
# which never got the same browser install, so the connector's tool calls
# fail with "Could not find Google Chrome executable" the moment sandboxing
# is turned on. Same ARG gate, same reasoning: deployments that never
# intend to enable this connector can drop the image size and the
# /opt/google/chrome/chrome binary + npx cache with
# --build-arg INSTALL_CHROME=false.
#
# Security posture, matching Dockerfile.backend's (not a new risk this
# image introduces): DockerSandboxService always creates/execs this
# container as root regardless of the USER directive later in this file
# (src/xagent/sandbox/docker_sandbox.py: "Run as root to match the file
# access behavior of Boxlite"), and the connector's launch_config passes
# --chrome-arg=--no-sandbox --chrome-arg=--disable-setuid-sandbox, so
# Chrome parses arbitrary page content as UID 0 with its own process
# sandbox disabled. Accepted for now only because the connector stays
# is_visible_in_connector: false until the security review that
# Dockerfile.backend's own comment tracks (root Chrome there too) is
# done -- do not treat this image as a safer alternative to that one.
ARG INSTALL_CHROME=true
# chrome-devtools-mcp's default "stable" channel resolution checks exactly
# /opt/google/chrome/chrome on Linux -- see Dockerfile.backend's block for
# the full per-architecture rationale (Google ships no arm64 Chrome; Debian
# Chromium is CDP-compatible and gets symlinked into the same path so both
# images and both architectures share one resolver path with no
# --executablePath override needed in builtin_mcp_registry.py's
# launch_config).
#
# fonts-liberation + fonts-noto-cjk on both branches: neither Debian's
# chromium package (its fonts-liberation dependency is only a Recommends,
# skipped by --no-install-recommends) nor this node:22-slim base image
# ships any font. Headless Chrome/Chromium with zero fonts installed
# renders text as blank/tofu boxes -- a silent failure of this
# connector's primary use case (screenshots, reading rendered page
# content), not a crash, so it wouldn't surface as a build or launch
# error. amd64's google-chrome-stable .deb hard-Depends on
# fonts-liberation already, making that half a no-op there, but explicit
# beats relying on an incidental transitive dependency; fonts-noto-cjk
# (CJK glyph coverage) is not pulled in by either package and matches
# Dockerfile.backend's shared runtime-base stage, which installs it
# unconditionally for the same connector.
RUN if [ "$INSTALL_CHROME" != "true" ]; then \
        echo "INSTALL_CHROME=$INSTALL_CHROME -- skipping Chrome/Chromium install"; \
    else \
        if [ "$(dpkg --print-architecture)" = "amd64" ]; then \
            apt-get update \
            && apt-get install -y --no-install-recommends -o Acquire::Retries=5 curl gnupg \
            && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
            && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
                > /etc/apt/sources.list.d/google-chrome.list \
            && apt-get update \
            && apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
                google-chrome-stable fonts-liberation fonts-noto-cjk \
            && apt-get purge -y --auto-remove -o APT::AutoRemove::RecommendsImportant=false curl gnupg \
            && rm -rf /var/lib/apt/lists/* /etc/apt/sources.list.d/google-chrome.list /usr/share/keyrings/google-chrome.gpg; \
        elif [ "$(dpkg --print-architecture)" = "arm64" ]; then \
            apt-get update \
            && apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
                chromium fonts-liberation fonts-noto-cjk \
            && rm -rf /var/lib/apt/lists/* \
            && mkdir -p /opt/google/chrome \
            && ln -s /usr/bin/chromium /opt/google/chrome/chrome; \
        else \
            echo "ERROR: unsupported architecture $(dpkg --print-architecture) for the chrome connector -- add an install branch, or build with --build-arg INSTALL_CHROME=false" >&2; \
            exit 1; \
        fi; \
        [ -e /opt/google/chrome/chrome ] || { echo "ERROR: the Chrome/Chromium install did not produce /opt/google/chrome/chrome -- update the chrome-devtools-mcp resolver path handling" >&2; exit 1; }; \
    fi

# Warm the npx cache for the exact version pinned in
# builtin_mcp_registry.py's launch_config, same rationale as
# Dockerfile.backend's identical step: avoid a needless npm-registry
# round-trip (and its latency/flakiness) on every sandboxed launch of
# this connector, not just the first. Reads/writes NPM_CONFIG_CACHE
# (set once, near the top of this stage) rather than the default
# $HOME/.npm/_npx, so this is correct regardless of which user actually
# execs npx at runtime -- deliberately not assumed to be this image's own
# `USER sandbox` (declared later in this file): DockerSandboxService
# always creates/execs this container with `"user": "root"` regardless
# of the image's own USER directive ("Run as root to match the file
# access behavior of Boxlite" -- src/xagent/sandbox/docker_sandbox.py).
# A cache keyed to $HOME would have to guess that correctly; one fixed,
# world-writable path doesn't need to -- verified this actually holds,
# not just in theory: `umask 0022` below, because the top-level
# NPM_CONFIG_CACHE directory being world-writable does not make npm's
# own subdirectories/files under it world-readable too (npm creates
# those with root's normal, restrictive umask); without this, a
# different exec user can list the cache directory but still gets
# ENOTCACHED trying to actually read a --offline resolution out of it.
# `--help` exercises resolution without starting Chrome, so this needs
# no display/GPU setup at build time. umask 0022 (world-readable, not
# world-writable): the goal is only cross-user *read* access to the
# warmed cache, so a laxer 0000 would needlessly leave the cache tree
# writable by any future lower-privileged process with filesystem
# access inside the container -- an avoidable way to tamper with a
# package `--prefer-offline` trusts without re-verifying.
RUN if [ "$INSTALL_CHROME" = "true" ]; then \
        umask 0022 && npx -y --prefer-offline chrome-devtools-mcp@1.6.0 --help > /dev/null; \
    fi

######################## tools dependencies

COPY --from=sandbox-requirements /sandbox-requirements.txt /tmp/sandbox-requirements.txt

# Install the exact versions exported from uv.lock. The import check fails the
# build if a supported runtime package is missing from the resulting image.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --break-system-packages \
        -r /tmp/sandbox-requirements.txt \
    && rm /tmp/sandbox-requirements.txt \
    && uvx --version \
    && python -c "import cloudpickle, fsspec, matplotlib, mcp; import numpy, openpyxl, pandas, pydantic, pydantic_settings"

# Allow pip install without --break-system-packages globally. Sandboxed tools
# can install their explicitly declared runtime dependencies as an unprivileged
# user after the container starts.
RUN printf '[global]\nbreak-system-packages = true\n' > /etc/pip.conf

########################

# Create sandbox user
RUN groupadd --gid 1010 sandbox \
    && useradd --uid 1100 --gid sandbox --shell /bin/bash --create-home sandbox

USER sandbox
WORKDIR /home/sandbox

CMD ["bash"]
